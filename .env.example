# ---- PostgreSQL ----
POSTGRES_USER=chat
# Use a URL-safe password (letters/digits) - it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat

# ---- Auth ----
# Generate with: openssl rand -hex 32   (must be >= 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Set to true when served over HTTPS
COOKIE_SECURE=false

# ---- Public URLs (as seen by the BROWSER) ----
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5000
# Backend REST + WebSocket URL (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
# LiveKit WebSocket URL
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ---- LiveKit ----
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 24   (LiveKit wants a long secret)
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-value
